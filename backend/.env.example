# ── KIS API ───────────────────────────────────────────────────────────────────
KIS_APP_KEY=                    # KIS 오픈API 앱키
KIS_APP_SECRET=                 # KIS 오픈API 앱시크릿
KIS_ACCOUNT_NO=                 # 계좌번호 (예: 50123456)
KIS_ACCOUNT_TYPE=01             # 계좌 유형 (01: 주식)
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_HTS_ID=                     # HTS ID (체결통보 WebSocket tr_key)

# ── 서버 ──────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
SQLITE_PATH=/data/trading.db
FRONTEND_DIST_PATH=./frontend/dist
FRONTEND_ORIGIN=https://your-project.web.app  # Firebase Hosting URL (https:// 포함 필수)

# ── API 인증 키 ────────────────────────────────────────────────────────────────
# 생성 예시: openssl rand -hex 32
ADMIN_API_KEY=                  # /api/admin/* 보호 — X-Admin-Key 헤더로 전달 (SQLite 직접 조회)
AGENT_API_KEY=                  # /api/agent/* 보호 — X-Agent-Key 헤더로 전달 (AI 에이전트용)

# ── Slack ──────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=                # xoxb-로 시작하는 Bot User OAuth Token
SLACK_DEFAULT_CHANNEL_ID=       # 기본/fallback 채널 ID
SLACK_ALERT_CHANNEL_ID=         # WARN/ERROR 로그 알림 채널 ID
SLACK_KIS_CHANNEL_ID=           # KIS API 연속 실패 알림 채널 ID
SLACK_TRADE_CHANNEL_ID=         # 매수/매도 체결 알림 채널 ID
SLACK_POSITION_CHANNEL_ID=      # 보유 포지션 현황 스냅샷 채널 ID
SLACK_KIS_FAIL_THRESHOLD=5      # KIS 연속 실패 횟수 임계값
SLACK_POSITION_SNAPSHOT_MIN=30  # 포지션 스냅샷 전송 주기 (분)
