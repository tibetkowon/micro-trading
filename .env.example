# ── KIS (한국투자증권) API ────────────────────────────────────────────────────
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=        # 계좌번호 앞 8자리만 입력 (예: 12345678)
KIS_ACCOUNT_TYPE=01    # 01=종합계좌, 22=선물옵션
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
# 모의투자: KIS_BASE_URL=https://openapivts.koreainvestment.com:29443

# KIS HTS ID — 실시간 체결통보(H0STCNI0) 구독 시 필요. 미설정 시 체결통보 미구독.
KIS_HTS_ID=

# ── Firebase / Firestore ──────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=                          # GCP 프로젝트 ID (예: micro-trading-cb6f5)
FIREBASE_CREDENTIALS_JSON=./firebase-credentials.json  # 서비스 계정 JSON 파일 경로

# ── 서버 설정 ─────────────────────────────────────────────────────────────────
SERVER_PORT=8080
FRONTEND_DIST_PATH=./frontend/dist            # 로컬 개발용 (프로덕션은 Firebase Hosting)

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=https://YOUR_PROJECT_ID.web.app  # Firebase Hosting 도메인

